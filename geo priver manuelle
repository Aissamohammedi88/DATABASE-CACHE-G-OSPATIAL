class Compressor:
@staticmethod
def compress(data, algo="auto"):
raw = json.dumps(data, ensure_ascii=False, default=str).encode("utf-8")
taille_orig = len(raw)
if algo == "auto":
if taille_orig < 512:
algo = "gzip"
elif taille_orig < 4096:
algo = "zlib"
else:
algo = "lzma"
try:
if algo == "gzip":
out = gzip.compress(raw, compresslevel=CONFIG["compression_level"])
elif algo == "zlib":
out = zlib.compress(raw, level=CONFIG["compression_level"])
elif algo == "bz2":
out = bz2.compress(raw, compresslevel=9)
elif algo == "lzma":
out = lzma.compress(raw, preset=9)
else:
out = gzip.compress(raw, compresslevel=CONFIG["compression_level"])
algo = "gzip"
except Exception:
out = gzip.compress(raw, compresslevel=9)
algo = "gzip"
return out, taille_orig, algo

@staticmethod
def decompress(data, algo="gzip"):
try:
if algo == "gzip":
raw = gzip.decompress(data)
elif algo == "zlib":
raw = zlib.decompress(data)
elif algo == "bz2":
raw = bz2.decompress(data)
elif algo == "lzma":
raw = lzma.decompress(data)
else:
raw = gzip.decompress(data)
return json.loads(raw.decode("utf-8"))
except Exception:
return None

@staticmethod
def cle(query):
return hashlib.sha256(query.encode("utf-8")).hexdigest()[:40]


