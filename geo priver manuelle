def fusion(lat, lon, rayon, cat=None):
resultats = []
lock = threading.RLock()

def worker(fn):
try:
r = fn(lat, lon, rayon, cat)
with lock:
resultats.extend(r)
except Exception:
pass

fns = [source_osm, source_nominatim, source_photon,
source_wikidata, source_overpass_mirror, source_local]

threads = []
for fn in fns:
t = threading.Thread(target=worker, args=(fn,), daemon=True)
t.start()
threads.append(t)

for t in threads:
t.join(timeout=CONFIG["timeout_source"] + 15)

uniques = {}
for l in resultats:
key = normaliser(l.get("nom", ""))[:30] + "__" + str(round(l.get("lat", 0), 3)) + "_" + str(round(l.get("lon", 0), 3))
if key in uniques:
ex = uniques[key]
ex["sources_multiples"] = ex.get("sources_multiples", 1) + 1
for champ in ("telephone", "site_web", "horaires", "adresse", "ville"):
if not ex.get(champ) and l.get(champ):
ex[champ] = l[champ]
ex["qualite_score"] = score_qualite(ex)
else:
l["sources_multiples"] = 1
uniques[key] = l

liste = list(uniques.values())
liste.sort(key=lambda x: x.get("distance_m", 999999))
liste = [x for x in liste if x.get("distance_m", 999999) <= rayon]
return liste[:CONFIG["max_resultats"]]


