class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="application/json"):
try:
gz = None
if len(content) > 500 and "gzip" in self.headers.get("Accept-Encoding", ""):
content = gzip.compress(content, 6)
gz = "gzip"
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
self.send_header("Access-Control-Allow-Headers", "Content-Type")
if gz:
self.send_header("Content-Encoding", gz)
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, obj, code=200):
self._send(code, json.dumps(obj, ensure_ascii=False, default=str).encode("utf-8"))

def _html(self, html):
self._send(200, html.encode("utf-8"), "text/html")

def do_OPTIONS(self):
self._send(204, b"")

def do_GET(self):
ip = self.client_address[0] if self.client_address else "?"
if not RATE.allow(ip):
return self._json({"erreur": "rate limit"}, 429)

try:
u = urllib.parse.urlparse(self.path)
p = u.path
q = urllib.parse.parse_qs(u.query)

if p in ("/", "/index.html"):
html = HTML.replace("__V__", VERSION).replace("__AUTEUR__", AUTEUR)
return self._html(html)

if p == "/api/health":
return self._json({"status": "ok", "version": VERSION})

if p == "/api/geoip":
pos = geoloc_ip()
if pos:
return self._json(pos)
return self._json({"erreur": "geoip impossible"}, 500)

if p == "/api/places/search":
try:
lat = float(q.get("lat", ["48.8566"])[0])
lon = float(q.get("lon", ["2.3522"])[0])
rayon = int(q.get("radius", [str(CONFIG["rayon_defaut"])])[0])
cat = q.get("category", [None])[0] or None
if cat == "":
cat = None
tri = q.get("sort", ["distance"])[0]
except Exception:
return self._json({"erreur": "params invalides"}, 400)
return self._json(search(lat, lon, rayon, cat, tri))

if p == "/api/stats":
return self._json({
"cache": CACHE.stats(),
"global": stats_globales(),
"timestamp": datetime.now(timezone.utc).isoformat(),
})

if p == "/api/favoris/list":
return self._json({"favoris": lister_favoris()})

if p == "/api/historique/list":
return self._json({"historique": lister_historique(100)})

return self._json({"erreur": "not found"}, 404)
except Exception as e:
return self._json({"erreur": str(e)[:200]}, 500)

def do_POST(self):
ip = self.client_address[0] if self.client_address else "?"
if not RATE.allow(ip):
return self._json({"erreur": "rate limit"}, 429)

try:
u = urllib.parse.urlparse(self.path)
p = u.path
length = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(length).decode("utf-8", "ignore") if length else "{}"
try:
data = json.loads(body)
except Exception:
data = {}

if p == "/api/cache/clear":
CACHE.vider()
return self._json({"status": "ok"})

if p == "/api/favoris/add":
lieu = data.get("lieu", {})
note = int(data.get("note", 5))
fid = ajouter_favori(lieu, note)
return self._json({"status": "ok", "id": fid})

return self._json({"erreur": "not found"}, 404)
except Exception as e:
return self._json({"erreur": str(e)[:200]}, 500)


