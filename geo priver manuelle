def log_stats(requete, latence, hit, nb, rayon, cat):
conn = get_db()
try:
conn.execute("INSERT INTO stats (timestamp, requete, latence_ms, cache_hit, resultats, rayon, categorie) VALUES (?, ?, ?, ?, ?, ?, ?)",
(time.time(), requete[:200], latence, hit, nb, rayon, cat or ""))
conn.commit()
except Exception:
pass
finally:
conn.close()


def stats_globales():
conn = get_db()
try:
c = conn.cursor()
c.execute("SELECT COUNT(*) as n, AVG(latence_ms) as a, SUM(cache_hit) as h, SUM(resultats) as r FROM stats")
row = c.fetchone()
except Exception:
row = {"n": 0, "a": 0, "h": 0, "r": 0}
finally:
conn.close()
return {
"requetes_total": row["n"] or 0,
"latence_moyenne_ms": round(row["a"] or 0, 3),
"cache_hits": row["h"] or 0,
"resultats_total": row["r"] or 0,
}


