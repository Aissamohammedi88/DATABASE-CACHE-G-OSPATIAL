class MultiCache:
def __init__(self):
self.ram = {}
self.order = collections.deque()
self.lock = threading.RLock()

def get(self, cle):
with self.lock:
if cle in self.ram:
return self.ram[cle]
conn = get_db()
try:
c = conn.cursor()
c.execute("SELECT data, compression, timestamp FROM cache WHERE cle = ?", (cle,))
row = c.fetchone()
if row:
if time.time() - row["timestamp"] > CONFIG["cache_ttl"]:
c.execute("DELETE FROM cache WHERE cle = ?", (cle,))
conn.commit()
return None
data = Compressor.decompress(row["data"], row["compression"])
if data:
c.execute("UPDATE cache SET hits = hits + 1 WHERE cle = ?", (cle,))
conn.commit()
self._ram_set(cle, data)
return data
except Exception:
pass
finally:
conn.close()
return None

def set(self, cle, data):
compressed, orig, algo = Compressor.compress(data)
self._ram_set(cle, data)
conn = get_db()
try:
c = conn.cursor()
c.execute("""INSERT OR REPLACE INTO cache
(cle, data, taille_originale, taille_compressee, compression, timestamp, hits, source)
VALUES (?, ?, ?, ?, ?, ?, COALESCE((SELECT hits FROM cache WHERE cle = ?), 0), ?)""",
(cle, compressed, orig, len(compressed), algo, time.time(), cle, "search"))
conn.commit()
except Exception:
pass
finally:
conn.close()

def _ram_set(self, cle, data):
with self.lock:
if cle not in self.ram:
self.order.append(cle)
if len(self.order) > CONFIG["cache_ram_max"]:
old = self.order.popleft()
self.ram.pop(old, None)
self.ram[cle] = data

def stats(self):
conn = get_db()
try:
c = conn.cursor()
c.execute("SELECT COUNT(*) as n, SUM(taille_originale) as o, SUM(taille_compressee) as cp, SUM(hits) as h FROM cache")
row = c.fetchone()
except Exception:
row = {"n": 0, "o": 0, "cp": 0, "h": 0}
finally:
conn.close()
o = row["o"] or 0
cp = row["cp"] or 0
ratio = (1 - cp / o) * 100 if o > 0 else 0
return {
"entrees_sqlite": row["n"] or 0,
"entrees_ram": len(self.ram),
"taille_originale": o,
"taille_compressee": cp,
"compression_pct": round(ratio, 2),
"total_hits": row["h"] or 0,
}

def vider(self):
with self.lock:
self.ram.clear()
self.order.clear()
conn = get_db()
try:
conn.execute("DELETE FROM cache")
conn.commit()
except Exception:
pass
finally:
conn.close()


