def distance(lat1, lon1, lat2, lon2):
R = 6371000.0
p1 = math.radians(lat1)
p2 = math.radians(lat2)
dp = math.radians(lat2 - lat1)
dl = math.radians(lon2 - lon1)
a = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
a = max(0.0, min(1.0, a))
return 2 * R * math.asin(math.sqrt(a))


def bbox(lat, lon, rayon_m):
dlat = rayon_m / 111320.0
cos_lat = math.cos(math.radians(lat))
if abs(cos_lat) < 0.01:
cos_lat = 0.01
dlon = rayon_m / (111320.0 * cos_lat)
return (lat - dlat, lon - dlon, lat + dlat, lon + dlon)


def normaliser(cat):
if not cat:
return "inconnu"
try:
import unicodedata
cat = unicodedata.normalize("NFKD", str(cat))
cat = "".join(c for c in cat if not unicodedata.combining(c))
except Exception:
pass
cat = cat.lower().strip()
cat = re.sub(r"[^a-z0-9_\-]", "_", cat)
return cat[:50] or "inconnu"


def score_qualite(lieu):
s = 0.0
if lieu.get("nom") and len(str(lieu["nom"])) > 2:
s += 20
if lieu.get("adresse"):
s += 15
if lieu.get("telephone"):
s += 10
if lieu.get("site_web"):
s += 10
if lieu.get("horaires"):
s += 15
if lieu.get("categorie") and lieu["categorie"] != "inconnu":
s += 10
if lieu.get("lat") and lieu.get("lon"):
s += 10
if lieu.get("sources_multiples", 1) >= 2:
s += 10
return min(100.0, s)


