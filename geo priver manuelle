def search(lat, lon, rayon=None, cat=None, tri="distance"):
if rayon is None:
rayon = CONFIG["rayon_defaut"]
if rayon > CONFIG["rayon_max"]:
rayon = CONFIG["rayon_max"]

t0 = time.time()
query_key = "search:{:.4f}:{:.4f}:{}:{}:{}".format(lat, lon, rayon, cat or "all", tri)
cle = Compressor.cle(query_key)

cached = CACHE.get(cle)
if cached:
dt = round((time.time() - t0) * 1000, 3)
cached["cache_hit"] = True
cached["latency_ms"] = dt
return cached

resultats = fusion(lat, lon, rayon, cat)

if tri == "distance":
resultats.sort(key=lambda x: x.get("distance_m", 999999))
elif tri == "qualite":
resultats.sort(key=lambda x: -x.get("qualite_score", 0))
elif tri == "nom":
resultats.sort(key=lambda x: (x.get("nom") or "").lower())
elif tri == "source":
resultats.sort(key=lambda x: x.get("source", ""))

data = {
"query": {"lat": lat, "lon": lon, "rayon": rayon, "categorie": cat, "tri": tri},
"results": resultats,
"count": len(resultats),
"timestamp": datetime.now(timezone.utc).isoformat(),
"version": VERSION,
}

CACHE.set(cle, data)
ajouter_historique(lat, lon, rayon, cat, len(resultats))
dt = round((time.time() - t0) * 1000, 3)
data["cache_hit"] = False
data["latency_ms"] = dt
log_stats(query_key, dt, 0, len(resultats), rayon, cat)
return data


