class Handler(BaseHTTPRequestHandler):

    def do_GET(self):

        parsed = urllib.parse.urlparse(self.path)

        q = urllib.parse.parse_qs(parsed.query)


        if parsed.path == "/":

            self._send_html(HTML)


        elif parsed.path == "/api/v1/health":

            self._send_json({

                "status": "healthy",

                "version": "1.0.0",

                "service": "Nexus Geo-Intel"

            })


        elif parsed.path == "/api/v1/places/search":

            lat = float(q.get("lat", ["48.8566"])[0])

            lon = float(q.get("lon", ["2.3522"])[0])

            rayon = int(q.get("radius", ["2000"])[0])

            cat = q.get("category", [None])[0] or None


            result = GeoEngine.search(lat, lon, rayon, cat)

            self._send_json(result)


        elif parsed.path == "/api/v1/stats":

            self._send_json({

                "cache": cache.stats(),

                "global": GeoEngine.stats_globales(),

                "timestamp": datetime.now().isoformat()

            })


        elif parsed.path == "/api/v1/places/detail":

            place_id = q.get("id", [""])[0]

            conn = get_db()

            c = conn.cursor()

            c.execute("SELECT * FROM lieux WHERE id = ?", (place_id,))

            row = c.fetchone()

            conn.close()

            if row:

                self._send_json({"status": "ok", "place": dict(row)})

            else:

                self._send_json({"status": "error", "message": "Place not found"})


        else:

            self.send_response(404)

            self.end_headers()


    def do_POST(self):

        parsed = urllib.parse.urlparse(self.path)

        length = int(self.headers.get("Content-Length", 0))

        body = self.rfile.read(length).decode("utf-8") if length else "{}"

        try:

            data = json.loads(body)

        except Exception:

            data = {}


        if parsed.path == "/api/v1/places/index":

            conn = get_db()

            c = conn.cursor()

            try:

                c.execute("""

                    INSERT OR REPLACE INTO lieux

                    (id, source, nom, categorie, adresse, lat, lon,

                     telephone, site_web, horaires, metadata)

                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)

                """, (

                    data.get("id", hashlib.md5(json.dumps(data).encode()).hexdigest()[:16]),

                    data.get("source", "custom"),

                    data.get("nom", ""),

                    data.get("categorie", ""),

                    data.get("adresse", ""),

                    data.get("lat", 0),

                    data.get("lon", 0),

                    data.get("telephone", ""),

                    data.get("site_web", ""),

                    data.get("horaires", ""),

                    json.dumps(data.get("metadata", {}))

                ))

                conn.commit()

                self._send_json({"status": "ok", "indexed": True})

            except Exception as e:

                self._send_json({"status": "error", "message": str(e)})

            finally:

                conn.close()

        else:

            self.send_response(404)

            self.end_headers()


    def _send_html(self, html):

        self.send_response(200)

        self.send_header("Content-Type", "text/html; charset=utf-8")

        self.end_headers()

        self.wfile.write(html.encode())


    def _send_json(self, data):

        self.send_response(200)

        self.send_header("Content-Type", "application/json; charset=utf-8")

        self.end_headers()

        self.wfile.write(json.dumps(data, ensure_ascii=False).encode())


    def log_message(self, *args):

        pass



