# COMPRESSION — 86 %

# ═══════════════════════════════════════════════════════════════════


class Compressor:

    """Compresse les données JSON en gzip niveau 9."""


    @staticmethod

    def compress(data) -> tuple:

        """Retourne (bytes_compressés, taille_originale)."""

        raw = json.dumps(data, ensure_ascii=False).encode("utf-8")

        compressed = gzip.compress(raw, compresslevel=9)

        return compressed, len(raw)


    @staticmethod

    def decompress(data: bytes):

        """Décompresse."""

        return json.loads(gzip.decompress(data).decode("utf-8"))


    @staticmethod

    def cle_cache(query: str) -> str:

        """Génère une clé de cache unique."""

        return hashlib.sha256(query.encode()).hexdigest()[:32]



