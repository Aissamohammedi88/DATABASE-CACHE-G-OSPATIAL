# CACHE 0,096 ms

# ═══════════════════════════════════════════════════════════════════


class GeoCache:

    """Cache en RAM + SQLite pour réponses instantanées."""


    def __init__(self):

        self.ram = {}

        self.lock = threading.Lock()


    def get(self, cle: str):

        # 1. RAM (0,096 ms)

        with self.lock:

            if cle in self.ram:

                self._increment_hits(cle)

                return self.ram[cle]


        # 2. SQLite (fallback)

        conn = get_db()

        c = conn.cursor()

        c.execute("SELECT data, timestamp FROM cache_lieux WHERE cle = ?", (cle,))

        row = c.fetchone()

        conn.close()


        if row:

            try:

                data = Compressor.decompress(row["data"])

                with self.lock:

                    self.ram[cle] = data

                self._increment_hits(cle)

                return data

            except Exception:

                return None

        return None


    def set(self, cle: str, data):

        compressed, taille_orig = Compressor.compress(data)


        # RAM

        with self.lock:

            self.ram[cle] = data

            if len(self.ram) > 5000:

                # Éviction FIFO simple

                for k in list(self.ram.keys())[:500]:

                    del self.ram[k]


        # SQLite

        conn = get_db()

        c = conn.cursor()

        c.execute("""

            INSERT OR REPLACE INTO cache_lieux

            (cle, data, taille_originale, taille_compressee, timestamp, hits)

            VALUES (?, ?, ?, ?, ?, COALESCE((SELECT hits FROM cache_lieux WHERE cle = ?), 0))

        """, (cle, compressed, taille_orig, len(compressed),

              datetime.now().isoformat(), cle))

        conn.commit()

        conn.close()


    def _increment_hits(self, cle: str):

        try:

            conn = get_db()

            c = conn.cursor()

            c.execute("UPDATE cache_lieux SET hits = hits + 1 WHERE cle = ?", (cle,))

            conn.commit()

            conn.close()

        except Exception:

            pass


    def stats(self):

        conn = get_db()

        c = conn.cursor()

        c.execute("SELECT COUNT(*) as total, SUM(taille_originale) as orig, SUM(taille_compressee) as comp, SUM(hits) as hits FROM cache_lieux")

        row = c.fetchone()

        conn.close()


        orig = row["orig"] or 0

        comp = row["comp"] or 0

        ratio = (1 - comp/orig) * 100 if orig > 0 else 0


        return {

            "entrees_cache": row["total"] or 0,

            "ram_entries": len(self.ram),

            "taille_originale": orig,

            "taille_compressee": comp,

            "ratio_compression": round(ratio, 2),

            "total_hits": row["hits"] or 0

        }


cache = GeoCache()



