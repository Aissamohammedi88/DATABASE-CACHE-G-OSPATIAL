# MOTEUR PRINCIPAL

# ═══════════════════════════════════════════════════════════════════


class GeoEngine:

    """Moteur géospatial principal."""


    @staticmethod

    def search(lat: float, lon: float, rayon: int = 2000,

               categorie: str = None) -> Dict:

        """Recherche géospatiale avec cache."""

        debut = time.time()


        # Clé de cache

        query_key = f"search:{lat:.4f}:{lon:.4f}:{rayon}:{categorie or 'all'}"

        cle = Compressor.cle_cache(query_key)


        # Cache hit ?

        cached = cache.get(cle)

        if cached:

            latence = (time.time() - debut) * 1000

            GeoEngine._log_stats(query_key, latence, 1, len(cached.get("results", [])))

            cached["cache_hit"] = True

            cached["latency_ms"] = round(latence, 3)

            return cached


        # Cache miss → calcul

        resultats = FusionEngine.fusion(lat, lon, rayon)


        if categorie:

            resultats = [r for r in resultats

                         if categorie.lower() in r.get("categorie", "").lower()]


        data = {

            "query": {"lat": lat, "lon": lon, "rayon": rayon, "categorie": categorie},

            "results": resultats,

            "count": len(resultats),

            "timestamp": datetime.now().isoformat(),

            "source": "nexus_geo_intel"

        }


        cache.set(cle, data)


        latence = (time.time() - debut) * 1000

        GeoEngine._log_stats(query_key, latence, 0, len(resultats))


        data["cache_hit"] = False

        data["latency_ms"] = round(latence, 3)

        return data


    @staticmethod

    def _log_stats(query: str, latence: float, hit: int, nb: int):

        try:

            conn = get_db()

            c = conn.cursor()

            c.execute("""

                INSERT INTO stats (timestamp, requete, latence_ms, hits_cache, resultats)

                VALUES (?, ?, ?, ?, ?)

            """, (datetime.now().isoformat(), query, latence, hit, nb))

            conn.commit()

            conn.close()

        except Exception:

            pass


    @staticmethod

    def stats_globales() -> Dict:

        conn = get_db()

        c = conn.cursor()

        c.execute("SELECT COUNT(*) as n, AVG(latence_ms) as avg_lat, SUM(hits_cache) as hits FROM stats")

        row = c.fetchone()

        conn.close()

        return {

            "requetes_total": row["n"] or 0,

            "latence_moyenne_ms": round(row["avg_lat"] or 0, 3),

            "cache_hits": row["hits"] or 0,

        }



