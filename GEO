def init_db():

    conn = sqlite3.connect(DB_PATH)

    c = conn.cursor()


    # Cache de lieux (clé = hash de la requête)

    c.execute("""

        CREATE TABLE IF NOT EXISTS cache_lieux (

            cle TEXT PRIMARY KEY,

            data BLOB,

            taille_originale INTEGER,

            taille_compressee INTEGER,

            timestamp TEXT,

            hits INTEGER DEFAULT 0

        )

    """)


    # Lieux indexés

    c.execute("""

        CREATE TABLE IF NOT EXISTS lieux (

            id TEXT PRIMARY KEY,

            source TEXT,

            nom TEXT,

            categorie TEXT,

            adresse TEXT,

            lat REAL,

            lon REAL,

            telephone TEXT,

            site_web TEXT,

            horaires TEXT,

            note REAL,

            avis_count INTEGER,

            statut TEXT DEFAULT 'actif',

            metadata TEXT

        )

    """)

    c.execute("CREATE INDEX IF NOT EXISTS idx_lat_lon ON lieux(lat, lon)")

    c.execute("CREATE INDEX IF NOT EXISTS idx_categorie ON lieux(categorie)")


    # Stats

    c.execute("""

        CREATE TABLE IF NOT EXISTS stats (

            id INTEGER PRIMARY KEY AUTOINCREMENT,

            timestamp TEXT,

            requete TEXT,

            latence_ms REAL,

            hits_cache INTEGER,

            resultats INTEGER

        )

    """)


    conn.commit()

    conn.close()



def get_db():

    conn = sqlite3.connect(DB_PATH, check_same_thread=False, timeout=30)

    conn.row_factory = sqlite3.Row

    conn.execute("PRAGMA journal_mode = WAL")

    conn.execute("PRAGMA synchronous = NORMAL")

    conn.execute("PRAGMA cache_size = -8000")

    return conn



