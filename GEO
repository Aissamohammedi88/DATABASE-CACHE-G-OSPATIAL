class FusionEngine:

    """Fusionne OSM + base locale + autres sources."""


    OVERPASS = "https://overpass-api.de/api/interpreter"


    @staticmethod

    def from_osm(lat: float, lon: float, rayon_m: int = 2000) -> List[Dict]:

        """Récupère les lieux depuis OpenStreetMap."""

        query = f"""

        [out:json][timeout:25];

        (

          node["amenity"](around:{rayon_m},{lat},{lon});

          way["amenity"](around:{rayon_m},{lat},{lon});

        );

        out center 100;

        """

        try:

            data = urllib.parse.urlencode({"data": query}).encode()

            req = urllib.request.Request(

                FusionEngine.OVERPASS, data=data,

                headers={"User-Agent": USER_AGENT}

            )

            with urllib.request.urlopen(req, timeout=25) as r:

                result = json.loads(r.read().decode("utf-8"))


            lieux = []

            for el in result.get("elements", []):

                tags = el.get("tags", {})

                lat_l = el.get("lat") or (el.get("center", {}) or {}).get("lat")

                lon_l = el.get("lon") or (el.get("center", {}) or {}).get("lon")

                if not lat_l or not lon_l:

                    continue


                lieux.append({

                    "id": f"osm_{el.get('id')}",

                    "source": "osm",

                    "nom": tags.get("name", "Sans nom"),

                    "categorie": tags.get("amenity", "inconnu"),

                    "adresse": f"{tags.get('addr:street','')} {tags.get('addr:housenumber','')}".strip(),

                    "lat": lat_l,

                    "lon": lon_l,

                    "telephone": tags.get("phone", ""),

                    "site_web": tags.get("website", ""),

                    "horaires": tags.get("opening_hours", ""),

                    "note": None,

                    "avis_count": 0,

                })

            return lieux

        except Exception as e:

            return []


    @staticmethod

    def from_local(lat: float, lon: float, rayon_km: float = 2) -> List[Dict]:

        """Récupère les lieux indexés localement."""

        conn = get_db()

        c = conn.cursor()

        c.execute("SELECT * FROM lieux WHERE statut = 'actif'")

        rows = [dict(r) for r in c.fetchall()]

        conn.close()


        resultats = []

        for r in rows:

            if r.get("lat") and r.get("lon"):

                dist = FusionEngine._distance(lat, lon, r["lat"], r["lon"])

                if dist <= rayon_km * 1000:

                    r["distance_m"] = round(dist, 0)

                    resultats.append(r)

        return resultats


    @staticmethod

    def _distance(lat1, lon1, lat2, lon2):

        R = 6371000

        p1, p2 = math.radians(lat1), math.radians(lat2)

        dp = math.radians(lat2 - lat1)

        dl = math.radians(lon2 - lon1)

        a = math.sin(dp/2)**2 + math.cos(p1)*math.cos(p2)*math.sin(dl/2)**2

        return 2 * R * math.asin(math.sqrt(a))


    @staticmethod

    def fusion(lat: float, lon: float, rayon_m: int = 2000) -> List[Dict]:

        """Fusionne toutes les sources."""

        osm = FusionEngine.from_osm(lat, lon, rayon_m)

        local = FusionEngine.from_local(lat, lon, rayon_m/1000)


        # Dédupliquer par nom + distance

        tous = {}

        for l in local + osm:

            key = f"{l['nom'].lower()}_{round(l['lat'], 4)}_{round(l['lon'], 4)}"

            if key not in tous:

                l["distance_m"] = round(FusionEngine._distance(

                    lat, lon, l["lat"], l["lon"]), 0)

                tous[key] = l


        resultats = list(tous.values())

        resultats.sort(key=lambda x: x.get("distance_m", 999999))

        return resultats[:60]



